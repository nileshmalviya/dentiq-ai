{
  "name": "dentiq-api",
  "private": true,
  "type": "module",
  "scripts": {
    "test:social": "tsx --test scripts/social-auth.test.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/generate-openapi.mjs",
    "seed:snapshot": "node scripts/generate-seed-data.mjs",
    "test:patient-language": "tsx --test scripts/patient-language.test.ts",
    "test:geolocation": "tsx --test scripts/geolocation.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.19.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.7.2"
  }
