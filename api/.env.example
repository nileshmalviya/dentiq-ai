NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/dentiq_ai?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-separate-32-character-secret
CLIENT_URL=http://localhost:5173
# Optional seed passwords. Required only when running npm run seed.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_PATIENT_PASSWORD=

# SMTP sender configuration (never commit actual credentials)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional absolute persistent directory for private registration documents
# PRIVATE_UPLOAD_DIR=C:/dentiq-private-documents
# Patient-only social login. Leave credentials blank until provider apps exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/social/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/auth/social/facebook/callback
FACEBOOK_GRAPH_VERSION=v24.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/v1/auth/social/linkedin/callback
